# ===========================================
# Real Estate Lead Bot - Environment Variables
# ===========================================
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.

# Application
ENVIRONMENT=development
DEBUG=true

# Backend
# FastAPI will load these via pydantic-settings
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/real_estate_lead_bot
# Or for sync: postgresql://postgres:password@localhost:5432/real_estate_lead_bot

# AI Provider (Google Gemini)
GEMINI_API_KEY=

# n8n Integration
N8N_WEBHOOK_URL=http://localhost:5678/webhook/lead-intake
N8N_WEBHOOK_SECRET=
N8N_API_KEY=

# Google Sheets (optional operational visibility)
GOOGLE_SHEETS_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Notifications (optional)
SLACK_WEBHOOK_URL=
NOTIFICATION_EMAIL_FROM=

# Frontend (Vite)
# Put these in frontend/.env if preferred
VITE_API_BASE_URL=http://localhost:8000
